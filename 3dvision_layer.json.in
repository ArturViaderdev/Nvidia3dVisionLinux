{
  "file_format_version": "1.2.0",
  "layer": {
    "name": "VK_LAYER_3DVISION_linux",
    "type": "GLOBAL",
    "library_path": "@LIB@",
    "api_version": "1.3.275",
    "implementation_version": "1",
    "description": "Real stereoscopic 3D (geometry) with NVIDIA 3D Vision shutter glasses, frame sequential 120 Hz",
    "functions": {
      "vkGetInstanceProcAddr": "nv3d_GetInstanceProcAddr",
      "vkGetDeviceProcAddr": "nv3d_GetDeviceProcAddr",
      "vkNegotiateLoaderLayerInterfaceVersion": "nv3d_NegotiateLoaderLayerInterfaceVersion"
    },
    "enable_environment": { "ENABLE_3DVISION": "1" },
    "disable_environment": { "DISABLE_3DVISION": "1" }
  }
}
